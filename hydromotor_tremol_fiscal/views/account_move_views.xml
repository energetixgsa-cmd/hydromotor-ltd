<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tremol" model="ir.ui.view">
        <field name="name">account.move.form.tremol</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tremol_test_connection"
                        type="object"
                        string="Test TREMOL connection"
                        class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice'"/>
                <button name="action_open_tremol_receipt_wizard"
                        type="object"
                        string="Issue fiscal receipt"
                        class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state not in ('paid', 'in_payment') or tremol_fiscal_state in ('processing', 'issued')"/>
                <button name="action_tremol_allow_retry"
                        type="object"
                        string="Allow TREMOL retry"
                        class="btn-secondary"
                        groups="base.group_system"
                        confirm="First verify on the device that no fiscal receipt was issued. Allow retry?"
                        invisible="tremol_fiscal_state not in ('processing', 'error')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="TREMOL fiscal receipt"
                       invisible="move_type != 'out_invoice'">
                    <field name="tremol_fiscal_state" widget="badge"/>
                    <field name="tremol_receipt_number" invisible="not tremol_receipt_number"/>
                    <field name="tremol_fiscal_issued_at" invisible="not tremol_fiscal_issued_at"/>
                    <field name="tremol_last_response" invisible="not tremol_last_response"/>
                    <field name="tremol_issue_token" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
