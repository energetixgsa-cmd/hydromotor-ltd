<odoo>
<record id="field_machine_x_hm_assignment_ids" model="ir.model.fields"><field name="model_id" ref="hydromotor_service.model_machine"/><field name="name">x_hm_assignment_ids</field><field name="ttype">one2many</field><field name="relation">hm.machine.assignment</field><field name="field_description">Site assignment history</field><field name="store" eval="True"/><field name="readonly" eval="True"/><field name="copied" eval="False"/><field name="required" eval="False"/><field name="index" eval="False"/><field name="relation_field">machine_id</field></record>
<record id="field_machine_x_hm_site_id" model="ir.model.fields"><field name="model_id" ref="hydromotor_service.model_machine"/><field name="name">x_hm_site_id</field><field name="ttype">many2one</field><field name="relation">project.project</field><field name="field_description">Actual site / Project</field><field name="store" eval="False"/><field name="readonly" eval="True"/><field name="copied" eval="False"/><field name="required" eval="False"/><field name="index" eval="False"/><field name="on_delete">restrict</field><field name="compute">for record in self:
    current = record.x_hm_assignment_ids.filtered(lambda a: not a.ended_at)[:1]
    record['x_hm_site_id'] = current.project_id.id if current else False</field><field name="depends">x_hm_assignment_ids,x_hm_assignment_ids.ended_at</field></record>
<record id="field_machine_x_hm_plant_id" model="ir.model.fields"><field name="model_id" ref="hydromotor_service.model_machine"/><field name="name">x_hm_plant_id</field><field name="ttype">many2one</field><field name="relation">hm.concrete.plant</field><field name="field_description">Actual concrete plant</field><field name="store" eval="False"/><field name="readonly" eval="True"/><field name="copied" eval="False"/><field name="required" eval="False"/><field name="index" eval="False"/><field name="on_delete">restrict</field><field name="compute">for record in self:
    current = record.x_hm_assignment_ids.filtered(lambda a: not a.ended_at)[:1]
    record['x_hm_plant_id'] = current.plant_id.id if current else False</field><field name="depends">x_hm_assignment_ids,x_hm_assignment_ids.ended_at</field></record>
<record id="field_machine_x_hm_assignment_revision" model="ir.model.fields"><field name="model_id" ref="hydromotor_service.model_machine"/><field name="name">x_hm_assignment_revision</field><field name="ttype">integer</field><field name="field_description">Assignment concurrency revision</field><field name="store" eval="True"/><field name="readonly" eval="True"/><field name="copied" eval="False"/><field name="required" eval="False"/><field name="index" eval="False"/></record>
</odoo>