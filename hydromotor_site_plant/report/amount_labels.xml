<odoo>
  <template id="bg_amount_labels" inherit_id="account.document_tax_totals_template">
    <xpath expr="//span[@t-out=&quot;subtotal['name']&quot;]" position="attributes">
      <attribute name="t-out">'Данъчна основа' if (env.context.get('lang') or '').startswith('bg') else subtotal['name']</attribute>
    </xpath>
    <xpath expr="//tr[@class='o_total']/td/strong" position="replace">
      <strong t-out="'Обща сума по документа' if (env.context.get('lang') or '').startswith('bg') else 'Total'"/>
    </xpath>
  </template>
  <template id="customer_invoice_total_label" inherit_id="hydromotor_report_signatures.report_customer_invoice_page">
    <xpath expr="//strong[contains(@t-out, &quot;'ОБЩО'&quot;)]" position="attributes">
      <attribute name="t-out">'Обща сума по документа' if hm_bg else 'TOTAL'</attribute>
    </xpath>
  </template>
</odoo>
