<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="service_current_assignment_form" model="ir.ui.view">
    <field name="name">x_hm_job.current.assignment</field><field name="model">x_hm_job</field>
    <field name="inherit_id" ref="hydromotor_service.job_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='x_machine_id']" position="after">
      <field name="x_hm_current_site_id" readonly="1"/>
      <field name="x_hm_current_plant_id" readonly="1"/>
      <div class="text-muted">Текущо местоположение на машината, не историческо местоположение към датата на документа.</div>
    </xpath></field>
  </record>
  <record id="sale_current_assignment_form" model="ir.ui.view">
    <field name="name">sale.order.current.machine.assignment</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="hydromotor_parts_kits.sale_order_customer_machine"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='partner_details']/field[@name='x_hm_order_machine_id']" position="after">
        <field name="hm_current_site_id" invisible="not x_hm_order_machine_id"/>
        <field name="hm_current_plant_id" invisible="not x_hm_order_machine_id"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='x_hm_parts_machine_id']" position="after">
        <field name="hm_current_site_id" optional="show"/>
        <field name="hm_current_plant_id" optional="show"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/form//field[@name='x_hm_parts_machine_id']" position="after">
        <field name="hm_current_site_id"/>
        <field name="hm_current_plant_id"/>
      </xpath>
    </field>
  </record>
  <record id="assignment_list" model="ir.ui.view">
    <field name="name">hm.machine.assignment.list</field><field name="model">hm.machine.assignment</field>
    <field name="arch" type="xml"><list edit="false" delete="false" decoration-muted="ended_at">
      <field name="machine_id"/><field name="project_id"/><field name="plant_id"/>
      <field name="started_at"/><field name="ended_at"/><field name="create_uid" optional="hide"/>
      <field name="company_id" groups="base.group_multi_company"/>
    </list></field>
  </record>
  <record id="assignment_form" model="ir.ui.view">
    <field name="name">hm.machine.assignment.form</field><field name="model">hm.machine.assignment</field>
    <field name="arch" type="xml"><form delete="false" duplicate="false">
      <header><button name="action_end" type="object" string="End actual assignment now" invisible="not id or ended_at" groups="hydromotor_service.group_service_user" confirm="End this actual assignment? This does not transfer ownership."/></header>
      <sheet><div class="alert alert-info" role="status">Actual placement only. New entry closes the previous actual assignment. Owner and commercial quotation targets are not changed.</div>
        <group><field name="machine_id" readonly="id" options="{'no_create': True}"/>
          <field name="company_id" readonly="True"/>
          <field name="project_id" readonly="id" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id}"/>
          <field name="plant_id" readonly="id" domain="[('project_id', '=', project_id), ('company_id', '=', company_id)]"/>
          <field name="request_key" invisible="True"/>
          <field name="started_at" readonly="True" invisible="not id"/>
          <field name="ended_at" readonly="True" invisible="not id"/>
          <field name="create_uid" readonly="True" invisible="not id"/>
          <field name="note" readonly="id"/>
        </group>
      </sheet>
    </form></field>
  </record>
  <record id="assignment_search" model="ir.ui.view">
    <field name="name">hm.machine.assignment.search</field><field name="model">hm.machine.assignment</field>
    <field name="arch" type="xml"><search><field name="machine_id"/><field name="project_id"/><field name="plant_id"/>
      <filter name="current" string="Current actual assignments" domain="[('ended_at', '=', False)]"/>
      <group><filter name="by_site" string="Site" context="{'group_by': 'project_id'}"/><filter name="by_plant" string="Concrete plant" context="{'group_by': 'plant_id'}"/></group>
    </search></field>
  </record>
  <record id="assignment_action" model="ir.actions.act_window"><field name="name">Actual machine assignments</field><field name="res_model">hm.machine.assignment</field><field name="view_mode">list,form</field></record>
  <record id="assign_machine_action" model="ir.actions.act_window"><field name="name">Record actual assignment</field><field name="res_model">hm.machine.assignment</field><field name="view_mode">form</field><field name="view_id" ref="assignment_form"/><field name="target">new</field></record>

  <record id="plant_list" model="ir.ui.view"><field name="name">hm.concrete.plant.list</field><field name="model">hm.concrete.plant</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="owner_id"/><field name="project_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field>
  </record>
  <record id="plant_form" model="ir.ui.view"><field name="name">hm.concrete.plant.form</field><field name="model">hm.concrete.plant</field>
    <field name="arch" type="xml"><form><header><button name="%(assign_machine_action)d" type="action" string="Assign existing machine" context="{'default_project_id': project_id, 'default_plant_id': id, 'default_company_id': company_id}" groups="hydromotor_service.group_service_user"/></header><sheet>
      <group><field name="name"/><field name="owner_id" string="Собственик на възела (клиент)"/><field name="company_id" string="Вътрешна фирма в Odoo"/><field name="project_id" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id}"/><field name="active"/></group>
      <div class="alert alert-info" role="status">A concrete plant is an installation grouping existing machines at a site, not an internal machine component.</div>
      <field name="assignment_ids" readonly="True"><list create="false" edit="false" delete="false" decoration-muted="ended_at"><field name="machine_id"/><field name="project_id"/><field name="started_at"/><field name="ended_at"/></list></field>
    </sheet></form></field>
  </record>
  <record id="plant_action" model="ir.actions.act_window"><field name="name">Concrete plants</field><field name="res_model">hm.concrete.plant</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_sites_root" web_icon="hydromotor_site_plant,static/description/icon.png" name="Sites and Plants" sequence="90" groups="hydromotor_service.group_service_user,sales_team.group_sale_salesman"/>
  <menuitem id="menu_plants" name="Concrete plants" parent="menu_sites_root" action="plant_action" sequence="10"/>
  <menuitem id="menu_assignments" name="Actual machine assignments" parent="menu_sites_root" action="assignment_action" sequence="20"/>

  <record id="machine_site_form" model="ir.ui.view"><field name="name">x_hm_machine.site.form</field><field name="model">x_hm_machine</field><field name="inherit_id" ref="hydromotor_service.machine_form"/>
    <field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Actual site assignment" groups="hydromotor_service.group_service_user,sales_team.group_sale_salesman">
      <field name="x_hm_site_id" readonly="True"/><field name="x_hm_plant_id" readonly="True"/>
      <button name="%(assign_machine_action)d" type="action" string="Assign / move existing machine" context="{'default_machine_id': id, 'default_company_id': x_company_id}" groups="hydromotor_service.group_service_user"/>
      <field name="x_hm_assignment_ids" readonly="True" nolabel="1"><list create="false" edit="false" delete="false" decoration-muted="ended_at"><field name="project_id"/><field name="plant_id"/><field name="started_at"/><field name="ended_at"/></list></field>
    </group></xpath></field>
  </record>
  <record id="project_site_form" model="ir.ui.view"><field name="name">project.project.site.form</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Plants and machines" name="hm_site" groups="hydromotor_service.group_service_user,sales_team.group_sale_salesman">
      <button name="%(assign_machine_action)d" type="action" string="Assign existing machine to site" context="{'default_project_id': id, 'default_company_id': company_id}" groups="hydromotor_service.group_service_user"/>
      <field name="hm_plant_ids" context="{'default_project_id': id, 'default_company_id': company_id}"><list><field name="name"/><field name="project_id"/><field name="company_id" groups="base.group_multi_company"/></list></field>
      <separator string="Actual assignment history"/>
      <field name="hm_assignment_ids" readonly="True"><list create="false" edit="false" delete="false" decoration-muted="ended_at"><field name="machine_id"/><field name="plant_id"/><field name="started_at"/><field name="ended_at"/></list></field>
    </page></xpath></field>
  </record>
  <record id="sale_target_form" model="ir.ui.view"><field name="name">sale.order.planned.site.form</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="hm_target_project_id" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id}"/>
        <field name="hm_target_plant_id" domain="[('project_id', '=', hm_target_project_id), ('company_id', '=', company_id)]"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
        <field name="hm_part_code" widget="CopyClipboardChar" readonly="1" optional="show"/>
        <field name="hm_use_order_target" optional="hide"/>
        <field name="hm_target_project_id" optional="show" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id}"/>
        <field name="hm_target_plant_id" optional="show" domain="[('project_id', '=', hm_target_project_id), ('company_id', '=', company_id)]"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
        <field name="hm_part_code" widget="CopyClipboardChar" readonly="1"/>
        <field name="hm_use_order_target"/><field name="hm_target_project_id" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id}"/>
        <field name="hm_target_plant_id" domain="[('project_id', '=', hm_target_project_id), ('company_id', '=', company_id)]"/>
      </xpath>
    </field>
  </record>
<record id="site_form" model="ir.ui.view">
<field name="name">project.project.hydromotor.site.entry</field><field name="model">project.project</field>
<field name="arch" type="xml"><form string="Site"><sheet>
<group><field name="name"/><field name="partner_id"/><field name="company_id" required="1"/></group>
<notebook><page string="Plants and machines">
<field name="hm_plant_ids" context="{'default_project_id': id, 'default_company_id': company_id}"><list><field name="name"/><field name="owner_id"/></list></field>
<field name="hm_assignment_ids" readonly="1"><list create="false" edit="false" delete="false"><field name="machine_id"/><field name="plant_id"/><field name="started_at"/><field name="ended_at"/></list></field>
</page></notebook></sheet></form></field></record>
<record id="site_action" model="ir.actions.act_window"><field name="name">Sites</field><field name="res_model">project.project</field><field name="view_mode">list,form</field><field name="context">{'default_company_id': allowed_company_ids[0]}</field></record>
<record id="site_action_form" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">form</field><field name="view_id" ref="site_form"/><field name="act_window_id" ref="site_action"/></record>
<menuitem id="menu_sites" name="Sites" parent="menu_sites_root" action="site_action" sequence="5"/>
</odoo>
