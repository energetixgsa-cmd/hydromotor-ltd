<odoo>
  <record id="quick_order_download_form" model="ir.ui.view">
    <field name="name">hm.quick.order.download.form</field><field name="model">hm.quick.order.download</field>
    <field name="arch" type="xml"><form create="false" edit="false"><group>
      <div>Две колони без заглавия: номер на частта и количество. Копирайте попълнените клетки в първото поле Material number на Quickorder.</div>
      <field name="filename" invisible="1"/><field name="file_data" filename="filename" widget="binary"/>
    </group><footer><button string="Затвори" special="cancel"/></footer></form></field>
  </record>
  <record id="sale_order_quick_order" model="ir.ui.view">
    <field name="name">sale.order.quick.order.export</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_hm_quick_order_export" type="object" string="Excel за Quick Order" groups="sales_team.group_sale_salesman"/></xpath></field>
  </record>
  <record id="sale_order_print_button" model="ir.ui.view">
    <field name="name">sale.order.explicit.print</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="%(sale.action_report_saleorder)d" type="action" string="Печат на поръчка" invisible="state != 'sale'" groups="sales_team.group_sale_salesman"/></xpath></field>
  </record>
  <record id="purchase_order_quick_order" model="ir.ui.view">
    <field name="name">purchase.order.quick.order.export</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_hm_quick_order_export" type="object" string="Excel за Quick Order" groups="purchase.group_purchase_user"/></xpath></field>
  </record>
</odoo>
