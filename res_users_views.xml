<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_hydromotor_report_names" model="ir.ui.view">
        <field name="name">res.users.form.hydromotor.report.names</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']" position="inside">
                <group string="Печат на документи / Document Printing">
                    <field name="invoice_name_bg" placeholder="напр. Георги Аенски"/>
                    <field name="invoice_name_en" placeholder="e.g. Georgi Aenski"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
