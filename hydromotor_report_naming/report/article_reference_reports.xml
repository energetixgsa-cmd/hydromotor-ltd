<odoo>
  <template id="hm_sale_report_article" inherit_id="sale.report_saleorder_document" priority="70">
    <xpath expr="//th[@name='th_description']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <t t-set="colspan_count" t-value="colspan_count + 1"/>
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//td[@name='td_product_name']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[@name='td_combo_name']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[@name='td_combo_name']" position="attributes">
      <attribute name="t-att-colspan">colspan_count - 1</attribute>
    </xpath>
    <xpath expr="//td[@name='td_section_group_name']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;"/>
    </xpath>
    <xpath expr="//td[@name='td_product_name']/span[@t-field='line.name']" position="attributes">
      <attribute name="t-field">line.hm_description</attribute>
    </xpath>
    <xpath expr="//td[@name='td_combo_name']/span[@t-field='line.name']" position="attributes">
      <attribute name="t-field">line.hm_description</attribute>
    </xpath>
  </template>
  <template id="hm_invoice_report_article" inherit_id="account.report_invoice_document" priority="70">
    <xpath expr="//th[@name='th_description']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//td[@name='account_invoice_line_name']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']" position="attributes">
      <attribute name="t-field">line.hm_description</attribute>
    </xpath>
    <xpath expr="(//t[@t-set='line_colspan'][starts-with(@t-value, '3 +')])[2]" position="attributes">
      <attribute name="t-value">1 + 3 + (1 if display_discount else 0) + (1 if display_taxes and not grouped_line.get('taxes') else 0)</attribute>
    </xpath>
    <xpath expr="(//t[@t-set='line_colspan'][starts-with(@t-value, '3 +')])[1]" position="attributes">
      <attribute name="t-value">1 + 3 + (1 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0)</attribute>
    </xpath>
    <xpath expr="//td[@colspan='2'][span[@t-field='line.name']]" position="attributes">
      <attribute name="colspan">3</attribute>
    </xpath>
    <xpath expr="//td[@name='account_invoice_line_name_grouped_desktop']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;" t-if="hide_details or grouped_line['display_type'] == 'product'">
        <span t-out="grouped_line.get('hm_article_number', '')"/>
      </td>
    </xpath>
    <xpath expr="//td[@name='account_invoice_line_name_grouped']" position="attributes">
      <attribute name="t-att-colspan">3 if grouped_line['display_type'] != 'product' and not hide_details else (2 if grouped_line['display_type'] != 'product' else 1)</attribute>
    </xpath>
  </template>
  <template id="hm_purchase_report_article" inherit_id="purchase.report_purchaseorder_document" priority="70">
    <xpath expr="//th[@name='th_description']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//td[@id='product']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[@id='product']/span[@t-field='line.name']" position="attributes">
      <attribute name="t-field">line.hm_description</attribute>
    </xpath>
  </template>
  <template id="hm_rfq_report_article" inherit_id="purchase.report_purchasequotation_document" priority="70">
    <xpath expr="//th[@name='th_description']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//td[@id='product']" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="order_line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[@id='product']/span[@t-field='order_line.name']" position="attributes">
      <attribute name="t-field">order_line.hm_description</attribute>
    </xpath>
  </template>
  <template id="hm_delivery_report_article" inherit_id="stock.report_delivery_document" priority="70">
    <xpath expr="//th[@name='th_sm_product']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//th[@name='th_sml_product']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//th[@name='th_sb_product']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//table[@name='stock_move_table']//tr[@t-as='move']/td[1]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="move.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//table[@name='stock_backorder_table']//tr[@t-as='bo_line']/td[1]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="bo_line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//span[@t-out='move._get_report_description_picking()']" position="attributes">
      <attribute name="t-out">move.product_id._hm_description_without_reference(move._get_report_description_picking())</attribute>
    </xpath>
    <xpath expr="//span[@t-out='bo_line._get_report_description_picking()']" position="attributes">
      <attribute name="t-out">bo_line.product_id._hm_description_without_reference(bo_line._get_report_description_picking())</attribute>
    </xpath>
  </template>
  <template id="hm_delivery_serial_article" inherit_id="stock.stock_report_delivery_has_serial_move_line" priority="70">
    <xpath expr="//td[span[@t-field='move_line.product_id']]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="move_line.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//span[@t-out='description']" position="attributes">
      <attribute name="t-out">move_line.product_id._hm_description_without_reference(description)</attribute>
    </xpath>
  </template>
  <template id="hm_delivery_aggregated_article" inherit_id="stock.stock_report_delivery_aggregated_move_lines" priority="70">
    <xpath expr="//tr[@t-as='line']/td[1]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="aggregated_lines[line].get('hm_article_number', '')"/>
      </td>
    </xpath>
  </template>
  <template id="hm_picking_report_article" inherit_id="stock.report_picking" priority="70">
    <xpath expr="//th[@name='th_product']" position="before">
      <th name="hm_th_article_number" class="text-start" style="width: 15%;">
        <span>Article Number</span>
      </th>
    </xpath>
    <xpath expr="//td[span[@t-field='move.product_id.display_name']]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;">
        <span t-out="move.hm_article_number"/>
      </td>
    </xpath>
    <xpath expr="//td[span[@t-out='line.lot_id.name']]" position="before">
      <td name="hm_td_article_number" class="text-start" style="overflow-wrap: anywhere;"/>
    </xpath>
    <xpath expr="//span[@t-out='move.description_picking']" position="attributes">
      <attribute name="t-out">move.product_id._hm_description_without_reference(move.description_picking)</attribute>
    </xpath>
  </template>
</odoo>
