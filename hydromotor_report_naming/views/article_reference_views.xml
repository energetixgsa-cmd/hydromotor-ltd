<odoo>
  <record id="hm_product_template_tree_view" model="ir.ui.view">
    <field name="name">product.template.article.number.hm_product_template_tree_view</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="priority">70</field>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='default_code']" position="attributes">
        <attribute name="string">Article Number</attribute>
        <attribute name="optional"/>
      </xpath>
      <xpath expr="//list/field[@name='name']" position="before">
        <xpath expr="//list/field[@name='default_code']" position="move"/>
      </xpath>
    </field>
  </record>
  <record id="hm_product_product_tree_view" model="ir.ui.view">
    <field name="name">product.product.article.number.hm_product_product_tree_view</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view"/>
    <field name="priority">70</field>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='default_code']" position="attributes">
        <attribute name="string">Article Number</attribute>
        <attribute name="optional"/>
      </xpath>
    </field>
  </record>
  <record id="hm_product_template_view_tree_tag" model="ir.ui.view">
    <field name="name">product.template.article.number.hm_product_template_view_tree_tag</field>
