<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SALES -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="print_report_name">object._hm_sale_pdf_filename()</field>
    </record>

    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="print_report_name">object._hm_sale_pdf_filename(force_proforma=True)</field>
    </record>

    <!-- ACCOUNTING -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="print_report_name">object._hm_invoice_pdf_filename()</field>
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="print_report_name">object._hm_invoice_pdf_filename()</field>
    </record>

    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="print_report_name">object._hm_payment_pdf_filename()</field>
    </record>

    <!-- INVENTORY -->
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="print_report_name">object._hm_delivery_pdf_filename()</field>
    </record>

    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="print_report_name">object._hm_picking_pdf_filename()</field>
    </record>

    <!-- PURCHASE -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="print_report_name">object._hm_purchase_pdf_filename()</field>
    </record>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="print_report_name">object._hm_purchase_pdf_filename(force_rfq=True)</field>
    </record>

    <!-- print_report_name is translatable in Odoo. Sync the same dynamic
         expression into every active UI language so a Bulgarian user interface
         cannot force a Bulgarian filename for an English customer. -->
    <function model="ir.actions.report" name="_hm_sync_report_name_translations"/>
</odoo>
