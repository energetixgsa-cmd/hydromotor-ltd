<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_hydromotor_legal_data" model="ir.ui.view">
        <field name="name">res.partner.form.hydromotor.legal.data</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat'][1]" position="after">
                <field name="hm_mol_bg" invisible="not is_company"/>
                <field name="hm_mol_en" invisible="not is_company"/>
                <field name="hm_name_en" invisible="not is_company"/>
                <field name="hm_address_en" invisible="not is_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_hydromotor_legal_data" model="ir.ui.view">
        <field name="name">res.company.form.hydromotor.legal.data</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="hm_mol_bg"/>
                <field name="hm_mol_en"/>
                <field name="hm_name_en"/>
                <field name="hm_address_en"/>
            </xpath>
        </field>
    </record>
</odoo>
