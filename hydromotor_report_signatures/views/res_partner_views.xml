<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_hydromotor_legal_data" model="ir.ui.view">
        <field name="name">res.partner.form.hydromotor.legal.data</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <!-- Make the standard fields unambiguous for Bulgarian accounting users. -->
            <xpath expr="//field[@name='vat'][1]" position="attributes">
                <attribute name="string">ДДС №</attribute>
            </xpath>
            <xpath expr="//field[@name='lang'][1]" position="attributes">
                <attribute name="string">Език на документите</attribute>
            </xpath>

            <!-- Keep all document/legal data together in the main partner form. -->
            <xpath expr="//field[@name='vat'][1]" position="after">
                <separator string="Данни за фактура / Invoice data"/>
                <field name="company_registry"
                       string="ЕИК / БУЛСТАТ"
                       invisible="not is_company"
                       placeholder="напр. 123456789"/>
                <field name="hm_mol_bg"
                       string="МОЛ / Представляващ"
                       invisible="not is_company"
                       placeholder="напр. Иван Иванов"/>
                <field name="hm_name_en"
                       string="Официално име на английски"
                       invisible="not is_company"
                       placeholder="e.g. Company Ltd."/>
                <field name="hm_address_en"
                       string="Официален адрес на английски"
                       invisible="not is_company"
                       placeholder="e.g. 1 Example St., Sofia 1000, Bulgaria"/>
                <field name="hm_mol_en"
                       string="МОЛ / Представляващ на английски"
                       invisible="not is_company"
                       placeholder="e.g. Ivan Ivanov"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_hydromotor_legal_data" model="ir.ui.view">
        <field name="name">res.company.form.hydromotor.legal.data</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat'][1]" position="attributes">
                <attribute name="string">ДДС №</attribute>
            </xpath>
            <xpath expr="//field[@name='company_registry'][1]" position="attributes">
                <attribute name="string">ЕИК / БУЛСТАТ</attribute>
            </xpath>
            <xpath expr="//field[@name='company_registry'][1]" position="after">
                <separator string="Данни за документи / Document data"/>
                <field name="hm_mol_bg" string="МОЛ / Представляващ" placeholder="напр. Иван Иванов"/>
                <field name="hm_name_en" string="Официално име на английски" placeholder="e.g. Hydromotor Ltd."/>
                <field name="hm_address_en" string="Официален адрес на английски"/>
                <field name="hm_mol_en" string="МОЛ / Представляващ на английски" placeholder="e.g. Ivan Ivanov"/>
            </xpath>
        </field>
    </record>
</odoo>
