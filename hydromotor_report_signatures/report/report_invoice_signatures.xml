<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_hydromotor_signatures" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='payment_term']" position="after">
            <div t-if="o.move_type == 'out_invoice'"
                 class="hm_invoice_signatures"
                 style="margin-top: 28px; page-break-inside: avoid; font-size: 11px;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
                    <tr>
                        <!-- Prepared by: automatic from invoice salesperson/responsible user -->
                        <td style="width: 33.33%; vertical-align: top; padding-right: 14px;">
                            <div style="font-weight: 600; margin-bottom: 7px;">
                                Съставил / Prepared by:
                            </div>
                            <div style="min-height: 22px;">
                                <t t-set="prepared_user" t-value="o.invoice_user_id or o.create_uid"/>
                                <t t-if="prepared_user">
                                    <t t-set="prepared_bg" t-value="prepared_user.invoice_name_bg or ''"/>
                                    <t t-set="prepared_en" t-value="prepared_user.invoice_name_en or ''"/>
                                    <t t-if="prepared_bg and prepared_en and prepared_bg != prepared_en">
                                        <span t-out="prepared_bg"/>
                                        <span> / </span>
                                        <span t-out="prepared_en"/>
                                    </t>
                                    <t t-elif="prepared_bg">
                                        <span t-out="prepared_bg"/>
                                    </t>
                                    <t t-elif="prepared_en">
                                        <span t-out="prepared_en"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="prepared_user.name"/>
                                    </t>
                                </t>
                            </div>
                            <div style="margin-top: 22px; font-weight: 600;">
                                Подпис / Signature:
                            </div>
                            <div style="height: 20px; border-bottom: 1px solid #333; width: 92%;">&#160;</div>
                        </td>

                        <!-- Issued / handed over by: intentionally blank for handwriting -->
                        <td style="width: 33.33%; vertical-align: top; padding-left: 7px; padding-right: 7px;">
                            <div style="font-weight: 600; margin-bottom: 2px;">
                                Издал / Предал
                            </div>
                            <div style="margin-bottom: 7px;">
                                Issued / Handed over by:
                            </div>
                            <div style="height: 22px; border-bottom: 1px solid #333; width: 92%;">&#160;</div>
                            <div style="margin-top: 22px; font-weight: 600;">
                                Подпис / Signature:
                            </div>
                            <div style="height: 20px; border-bottom: 1px solid #333; width: 92%;">&#160;</div>
                        </td>

                        <!-- Accepted by: intentionally blank for handwriting -->
                        <td style="width: 33.33%; vertical-align: top; padding-left: 14px;">
                            <div style="font-weight: 600; margin-bottom: 7px;">
                                Приел / Accepted by:
                            </div>
                            <div style="height: 22px; border-bottom: 1px solid #333; width: 92%;">&#160;</div>
                            <div style="margin-top: 22px; font-weight: 600;">
                                Подпис / Signature:
                            </div>
                            <div style="height: 20px; border-bottom: 1px solid #333; width: 92%;">&#160;</div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
