<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Kept under the original XML ID so upgrades replace the old view.
        Signature rendering is now handled centrally from web.external_layout,
        which also covers Studio/custom invoice templates.
    -->
    <template id="report_invoice_document_hydromotor_signatures"
              inherit_id="account.report_invoice_document"
              priority="999">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' invoice_main ')]"
               position="inside">
            <t t-if="False"/>
        </xpath>
    </template>
</odoo>
