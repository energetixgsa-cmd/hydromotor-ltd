<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Kept under the original XML ID so upgrades replace the old view.
        Signature rendering is now handled centrally from web.external_layout,
        which covers quotations AND confirmed sales orders.
    -->
    <template id="report_saleorder_document_hydromotor_signatures"
              inherit_id="sale.report_saleorder_document"
              priority="999">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' page ')]"
               position="inside">
            <t t-if="False"/>
        </xpath>
    </template>
</odoo>
