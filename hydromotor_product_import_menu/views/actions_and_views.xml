<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="hydromotor_product_import_menu.view_product_import_list" model="ir.ui.view">
    <field name="name">hydromotor.product.import.list</field>
    <field name="model">product.product</field>
    <field name="type">list</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <list string="Продукти за импорт" import="1" create="1" default_order="default_code, id">
                <field name="default_code"/>
                <field name="name"/>
                <field name="list_price"/>
                <field name="type" optional="hide"/>
                <field name="sale_ok" optional="show"/>
                <field name="purchase_ok" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
    </field>
  </record>
  <record id="hydromotor_product_import_menu.action_product_import" model="ir.actions.act_window">
    <field name="name">Продукти за импорт / Product Import</field>
    <field name="res_model">product.product</field>
    <field name="target">current</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="binding_type">action</field>
    <field name="binding_view_types">list,form</field>
    <field name="view_id" ref="hydromotor_product_import_menu.view_product_import_list"/>
    <field name="search_view_id" ref="product.product_search_form_view"/>
    <field name="limit" eval="80"/>
  </record>
  <record id="hydromotor_product_import_menu.action_product_import_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="hydromotor_product_import_menu.view_product_import_list"/>
    <field name="act_window_id" ref="hydromotor_product_import_menu.action_product_import"/>
  </record>
  <record id="hydromotor_product_import_menu.action_product_import_form" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="product.product_normal_form_view"/>
    <field name="act_window_id" ref="hydromotor_product_import_menu.action_product_import"/>
  </record>
  <record id="hydromotor_product_import_menu.menu_product_import" model="ir.ui.menu">
    <field name="name">Продукти за импорт / Product Import</field>
    <field name="sequence" eval="20"/>
    <field name="active" eval="True"/>
    <field name="parent_id" ref="sale.product_menu_catalog"/>
    <field name="action" eval="'ir.actions.act_window,%d' % ref('hydromotor_product_import_menu.action_product_import')"/>
    <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
  </record>
</odoo>
